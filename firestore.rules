rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function companyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMember(companyId) {
      let data = companyData(companyId);
      return 'members' in data && request.auth.uid in data.members;
    }

    function memberRole(companyId) {
      return companyData(companyId).members[request.auth.uid].role;
    }

    // ── User profiles (owner workspaces) ───────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Organization metadata ──────────────────────────────────────────────────
    // orgId == ownerUid; owner has full access, members can read.
    match /organizations/{orgId} {
      allow read, write: if request.auth != null && request.auth.uid == orgId;
    }

    // ── Subscription records ───────────────────────────────────────────────────
    // Written by Cloud Functions (webhook); owner reads their own.
    match /subscriptions/{orgId} {
      allow read, write: if request.auth != null && request.auth.uid == orgId;
    }

    // ── Per-user company memberships (one doc per invited user) ────────────────
    match /userMemberships/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Invite tokens ──────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read, create, delete: if request.auth != null;
    }

    // ── Company metadata document (hosts the members map) ─────────────────────
    match /companies/{companyId} {
      // Owner has full access
      allow read, write: if request.auth != null &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid;
      // Owner can also create (resource is null before creation)
      allow create: if request.auth != null;
      // Members can read
      allow read: if request.auth != null &&
        resource != null &&
        'members' in resource.data &&
        request.auth.uid in resource.data.members;
      // Admin members can update the members map
      allow update: if request.auth != null &&
        resource != null &&
        'members' in resource.data &&
        request.auth.uid in resource.data.members &&
        resource.data.members[request.auth.uid].role == 'admin';
      // Allow self-provisioning from invite
      allow create, update: if request.auth != null &&
        request.resource.data.keys().hasAll(['members']) &&
        request.auth.uid in request.resource.data.members;
    }

    // ── Payroll data sub-documents ─────────────────────────────────────────────
    match /companies/{companyId}/payroll/{key} {
      // Owner always has full access
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
      // Members can read
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        isMember(companyId);
      // Editor and Admin members can write
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        isMember(companyId) &&
        memberRole(companyId) in ['admin', 'editor'];
    }
  }
}
