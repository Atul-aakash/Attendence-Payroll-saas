# ── Firebase ────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── EmailJS (for team invite notifications) ──────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Razorpay (frontend key — safe to expose) ─────────────────────────────────
VITE_RAZORPAY_KEY_ID=

# ── Super-admin UID (Firebase UID of the platform super-admin) ───────────────
VITE_SUPER_ADMIN_UID=

# ── Atlash AI — Google Gemini Flash (get keys at aistudio.google.com) ────────
# Add up to 3 keys for automatic failover when one hits its quota limit
VITE_GEMINI_API_KEY_1=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=
