# Firebase Cloud Functions secrets
# Set these with:  firebase functions:secrets:set SECRET_NAME
# View them with:  firebase functions:secrets:access SECRET_NAME

# ── Razorpay API (backend — never expose to frontend) ───────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret from Razorpay dashboard > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Razorpay Plan IDs ────────────────────────────────────────────────────────
# Create monthly plans in Razorpay Dashboard > Products > Subscriptions > Plans
RAZORPAY_PLAN_STARTER=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_PRO=plan_xxxxxxxxxxxx

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail address. For EMAIL_SMTP_PASS, generate an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
EMAIL_FROM=PayrollSaaS <noreply@yourdomain.com>
EMAIL_SMTP_USER=youremail@gmail.com
EMAIL_SMTP_PASS=your_16_char_app_password

# ── App URL (shown in email CTAs) ────────────────────────────────────────────
# Set via:  firebase functions:config:set app.url="https://your-app.web.app"
# Or hardcode below (used as fallback)
APP_URL=https://your-app.web.app
